<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vishmurda.retirement-lab.backend</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/python@3.12/bin/python3.12</string>
    <string>-m</string>
    <string>backend.server</string>
    <string>--port</string>
    <string>8000</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/vishmurda/Library/Application Support/RetirementLab/runtime</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>3</integer>
  <key>StandardOutPath</key>
  <string>/Users/vishmurda/Library/Application Support/RetirementLab/logs/backend.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/vishmurda/Library/Application Support/RetirementLab/logs/backend.stderr.log</string>
</dict>
</plist>
